# EAAWP environment — copy this to .env and fill in real values
# Never commit .env to version control

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME="EAAWP"

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL for the FastAPI backend (no trailing slash)
VITE_API_BASE_URL="http://localhost:8000"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to use real backend API calls. "false" uses mock data.
VITE_USE_REAL_API="false"
