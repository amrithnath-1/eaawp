# EAAWP Backend — copy to backend/.env and fill in real values
# Never commit .env to version control

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Default model for the LLM Gateway (must be in ALLOWED_MODELS in app/llm/config.py)
# LLM_DEFAULT_MODEL="gpt-4o-mini"

# ── Google Gemini LLM ─────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
# Both OpenAI and Gemini can coexist — the gateway selects the right one
# based on the model name or LLM_DEFAULT_PROVIDER.
GEMINI_API_KEY=
# Default Gemini model (used when LLM_DEFAULT_PROVIDER=google)
# GEMINI_DEFAULT_MODEL="gemini-3.5-flash-lite"
# Set to "google" to make Gemini the default for all agents,
# or leave as "openai" to keep OpenAI as default.
# LLM_DEFAULT_PROVIDER="openai"

# Embedding model for RAG / knowledge base vector search.
# Must match the OpenAI text-embedding model name.
# Changing this after documents are indexed requires re-indexing.
EMBEDDING_MODEL="text-embedding-3-small"

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Shared credentials for both Google Search Console AND Google Analytics.
# Register at https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Google Search Console API, Google Analytics Data API
# OAuth type: Web application
# Authorized redirect URIs:
#   http://localhost:8000/api/v1/oauth/google/callback
#
# GSC scope:  https://www.googleapis.com/auth/webmasters.readonly
# GA scope:   https://www.googleapis.com/auth/analytics.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match EXACTLY what is registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite — zero setup, file stored in backend/):
DATABASE_URL="sqlite+aiosqlite:///./eaawp.db"

# Production (PostgreSQL — uncomment and fill in):
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/eaawp"

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="changeme-generate-a-real-secret-key"

# JWT algorithm — do not change unless rotating to RS256/ES256
ALGORITHM="HS256"

# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Refresh token lifetime (days) — used by DB-persisted refresh token records
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173"

# ── Environment ──────────────────────────────────────────────────────────────
# "development" enables X-Tenant-ID header fallback for demo mode.
# "production" requires JWT for all tenant-scoped requests.
ENVIRONMENT="development"
