# EAAWP Backend — copy to backend/.env and fill in real values
# Never commit .env to version control

# ── LLM ───────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY is optional — only needed if you want GPT models.
# Document embeddings now use Gemini (GEMINI_API_KEY below).
OPENAI_API_KEY=
# Default model for the LLM Gateway (must be in ALLOWED_MODELS in app/llm/config.py)
# LLM_DEFAULT_MODEL="gpt-4o-mini"

# ── Google Gemini — LLM + Embeddings ─────────────────────────────────────────
# Required for: AI chat, document indexing, and document search.
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Default Gemini chat model
# GEMINI_DEFAULT_MODEL="gemini-3.5-flash-lite"
# Set to "google" to make Gemini the default for all agents.
# LLM_DEFAULT_PROVIDER="google"
# Chat engine: "agent" (default; the AI calls tools itself step by step, like ChatGPT/Claude) or "planner".
# CHAT_ENGINE="agent"

# Gemini embedding model for RAG / knowledge base vector search.
# Both indexing and retrieval must use the same model.
# Changing this after documents are indexed requires full re-indexing.
# Confirmed available (3072 dims each):
#   models/gemini-embedding-001  — stable alias
#   models/gemini-embedding-2    — current recommended
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-2"

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Shared credentials for both Google Search Console AND Google Analytics.
# Register at https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable: Google Search Console API, Google Analytics Data API
# OAuth type: Web application
# Authorized redirect URIs:
#   http://localhost:8000/api/v1/oauth/google/callback
#
# GSC scope:  https://www.googleapis.com/auth/webmasters.readonly
# GA scope:   https://www.googleapis.com/auth/analytics.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match EXACTLY what is registered in Google Cloud Console (scheme, host,
# port, path, trailing slash). In production use https://<api-host>/api/v1/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite — zero setup, file stored in backend/):
DATABASE_URL="sqlite+aiosqlite:///./eaawp.db"

# Production (PostgreSQL — uncomment and fill in):
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/eaawp"

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. The server refuses to start while this is empty, shorter than 32
# characters, or contains placeholder text such as "changeme" or "replace".
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional but recommended in production: a SEPARATE key used only to encrypt
# stored integration credentials (Google tokens, DB passwords). Same generator
# as above. Data encrypted before you set it stays readable (SECRET_KEY remains
# a fallback for decryption), but anything written under ENCRYPTION_KEY can only
# be read while ENCRYPTION_KEY is set. Existing credentials are NOT re-encrypted
# automatically: re-save/reconnect them before you ever rotate SECRET_KEY.
# ENCRYPTION_KEY=

# JWT algorithm. Must be HS256, HS384 or HS512 (the server refuses anything else).
ALGORITHM="HS256"

# Optional JWT issuer / audience. When set they are written into every new token
# and REQUIRED on every token presented. Turning them on signs everyone out.
# JWT_ISSUER=
# JWT_AUDIENCE=

# Access token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Refresh token lifetime (days) — used by DB-persisted refresh token records
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Abuse protection for the public endpoints ────────────────────────────────
# In-memory and per API process: with N workers/replicas the real limit is N x
# these values and a restart resets them. Add a shared limiter (reverse proxy /
# Redis) for multi-instance production.
# RATE_LIMIT_ENABLED=true
# Number of reverse proxies in front of the API whose X-Forwarded-For entry can
# be trusted. 0 (default) = ignore the header and use the socket address, which
# behind a proxy means every client looks like the proxy: SET THIS in production.
# TRUSTED_PROXY_COUNT=0

# Self-service company registration (POST /api/v1/onboarding/company)
# REGISTRATION_ENABLED=true               # false closes public sign-up
# REGISTRATION_RATE_LIMIT=5               # registrations per client IP ...
# REGISTRATION_RATE_WINDOW_SECONDS=3600   # ... per window
# REGISTRATION_DAILY_CAP=500              # registrations per process per 24h

# Login / token endpoints
# LOGIN_RATE_LIMIT=30                     # login attempts per client IP ...
# LOGIN_RATE_WINDOW_SECONDS=60            # ... per window
# LOGIN_MAX_FAILURES=5                    # failures per (IP, company, email) before lockout
# LOGIN_FAILURE_WINDOW_SECONDS=900        # lockout / counting window (15 min)
# REFRESH_RATE_LIMIT=60                   # refresh + logout calls per IP ...
# REFRESH_RATE_WINDOW_SECONDS=60          # ... per window
# OAUTH_CALLBACK_RATE_LIMIT=30
# OAUTH_CALLBACK_RATE_WINDOW_SECONDS=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Explicit origins only. "*" is refused in production because credentials are
# allowed. In production put your FRONTEND URL FIRST: the Google OAuth callback
# redirects the browser back to the first origin in this list.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# ── Environment ──────────────────────────────────────────────────────────────
# Every authenticated endpoint ALWAYS requires a valid Bearer JWT, in every
# environment. The X-Tenant-ID header is ignored: the tenant and role come from
# the database user the verified token points to. There is no demo fallback.
# "production" additionally disables /docs, /redoc and /openapi.json and
# enforces explicit CORS origins.
ENVIRONMENT="development"

# Log every SQL statement (bound values are never logged). Debugging aid only.
# SQL_ECHO=false
