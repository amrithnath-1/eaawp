# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/

# ── Environment / secrets — NEVER commit real values ─────────────────────────
.env
.env.*
!.env.example

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── TypeScript incremental cache ─────────────────────────────────────────────
*.tsbuildinfo

# ── Package manager lock files (project uses npm) ────────────────────────────
bun.lock
yarn.lock
pnpm-lock.yaml

# ── Misc ─────────────────────────────────────────────────────────────────────
*.local
.cache/

# ── Databases — never commit live data ───────────────────────────────────────
*.db
*.sqlite
*.sqlite3

uploads/
